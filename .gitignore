# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
env.bak/

# Jupyter
.ipynb_checkpoints/

# Local configuration and secrets
.env
.env.*
!.env.example
*.key
*.pem

# IDE / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.temp

# Local model / data artifacts
*.pkl
*.joblib
*.pickle

# Raw and generated data files — keep the repository lightweight
# Commit only deliberately selected small/sample datasets.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated reports / dashboard exports can be added deliberately later
reports/generated/*
!reports/.gitkeep
